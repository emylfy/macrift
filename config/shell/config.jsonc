{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/cat.txt",
        "type": "file",
        "color": {
            "1": "green"
        },
        "padding": {
            "top": 1,
            "left": 1,
            "right": 5
        },
        "width": 6
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 10
        },
        "color": {
            "keys": "green",
            "title": "yellow"
        }
    },
    "modules": [
	"break",
        {
            "type": "title",
            "format": "\u001b[33m{1}@{2}\u001b[0m"
        },
        {
            "type": "os",
            "key": "os",
            "format": "{name} {codename}"
        },
        {
            "type": "host",
            "key": "host",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "uptime"
        },
        {
            "type": "memory",
            "key": "memory"
        },
	"break"
    ]
}
