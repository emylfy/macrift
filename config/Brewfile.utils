# Third-party taps
tap "nikitabobko/tap"   # aerospace tiling WM

# Homebrew GUI
cask "cork"

# Launchers
cask "raycast"
cask "alfred"           # optional

# Menu bar & Window management
cask "hiddenbar"
cask "alt-tab"
cask "keyboard-cowboy"  # optional
cask "aerospace"        # optional — from nikitabobko/tap (taps above)

# Files & Downloads
cask "keka"
cask "motrix"           # optional

# Audio & Display
cask "soundsource"
cask "betterdisplay"

# Passwords & Security
cask "proton-pass"      # optional
cask "1password"

# Remote & Peripherals
cask "rustdesk"
cask "logi-options+"    # optional
cask "macs-fan-control" # optional

# Productivity
cask "todoist"
