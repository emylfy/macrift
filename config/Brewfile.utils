# Third-party taps
tap "nikitabobko/tap"   # aerospace tiling WM

# Homebrew GUI
cask "cork"             # menu bar GUI for Homebrew

# Launchers
cask "raycast"          # launcher + clipboard history + window snapping
cask "alfred"           # optional — classic launcher

# Menu bar & Window management
cask "hiddenbar"        # hide menu bar icons
cask "alt-tab"          # Windows-style Cmd-Tab with window previews
cask "keyboard-cowboy"  # optional — keyboard automation
cask "aerospace"        # optional — tiling WM from nikitabobko/tap (taps above)

# Files & Downloads
cask "keka"             # archiver — 7z, rar, zip
cask "motrix"           # optional — download manager

# Audio & Display
cask "soundsource"      # per-app volume and audio routing
cask "betterdisplay"    # display resolutions, HiDPI, brightness

# Passwords & Security
cask "proton-pass"      # optional — Proton password manager
cask "1password"        # password manager

# Remote & Peripherals
cask "rustdesk"         # open-source remote desktop
cask "logi-options+"    # optional — Logitech mouse/keyboard driver
cask "macs-fan-control" # optional — manual fan control

# Productivity
cask "todoist"          # todo lists and projects
