#!/usr/bin/env bash
# Auto-tag the pushed VERSION so the in-app update changelog ALWAYS has a
# precise `v<VERSION>...main` compare range. One tag per push (the pushed tip),
# not per commit — every published VERSION ends up tagged, with no tag spam.
#
# We create the tag and push it from inside this hook (git's own ref list for
# the in-flight push is already fixed, so we can't rely on follow-tags here).
# MACRIFT_TAG_PUSH guards against re-entering this hook on that tag push.

set -euo pipefail

[[ -n "${MACRIFT_TAG_PUSH:-}" ]] && exit 0

remote="$1"

while read -r local_ref local_sha remote_ref remote_sha; do
    # Only tag pushes of main; skip branch deletions (all-zero sha)
    [[ "$local_ref" == "refs/heads/main" ]] || continue
    [[ "$local_sha" =~ ^0+$ ]] && continue

    # Don't tag/release a push that will be rejected as non-fast-forward — the
    # pushed tag (and GitHub Release) would point at a commit that never lands
    # on main. The push itself still runs and reports the rejection.
    if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha" 2>/dev/null \
        && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        printf '[pre-push] push of main is not fast-forward — skipping tag/release\n' >&2
        continue
    fi

    v=$(git show "$local_sha:VERSION" 2>/dev/null || true)
    [[ -z "$v" ]] && continue

    if ! git rev-parse -q --verify "refs/tags/v$v" >/dev/null; then
        git tag -a "v$v" -m "Release v$v" "$local_sha"
        printf '[pre-push] tagged v%s\n' "$v" >&2
    fi

    # Push ONLY this tag now (carries the tip commit too). followTags is forced
    # off here so we don't also shove every reachable tag and collide with the
    # outer push. Guarded against re-entering this hook.
    MACRIFT_TAG_PUSH=1 git -c push.followTags=false push "$remote" "refs/tags/v$v" >&2

    # Optional: create a GitHub Release with a cliff-rendered body. Both gh and
    # git-cliff are optional — if either is missing, the tag still gets pushed
    # (above) and the release can be created by hand. Failures are non-fatal.
    if command -v gh >/dev/null 2>&1; then
        notes=""
        if command -v git-cliff >/dev/null 2>&1; then
            notes=$(git-cliff --latest --strip header --tag "v$v" 2>/dev/null || true)
        fi
        [[ -z "$notes" ]] && notes="Release v$v"
        if gh release view "v$v" >/dev/null 2>&1; then
            printf '[pre-push] gh release v%s already exists — skipping create\n' "$v" >&2
        elif printf '%s\n' "$notes" | gh release create "v$v" --notes-file - --title "v$v" 2>/dev/null; then
            printf '[pre-push] created gh release v%s\n' "$v" >&2
            # Attach the checksummed tarball + bump the Homebrew formula. Best-effort:
            # stdin detached so it can't consume this loop's ref list, and a failure
            # must not abort the push (the tag + release are already up).
            relscript="$(git rev-parse --show-toplevel)/scripts/release-assets.sh"
            if [[ -f "$relscript" ]]; then
                bash "$relscript" "v$v" </dev/null >&2 \
                    || printf '[pre-push] release-assets v%s failed — release made, assets/formula incomplete\n' "$v" >&2
            fi
        else
            printf '[pre-push] gh release create v%s failed (auth? rate limit?) — tag still pushed\n' "$v" >&2
        fi
    fi
done

exit 0
