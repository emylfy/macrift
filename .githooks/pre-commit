#!/usr/bin/env bash
# Auto-bump VERSION on code commits to main. Override with SKIP_BUMP=1.
# Calver YY.MM with patch suffix: 26.05 → 26.05.1 → 26.05.2 → (new month) 26.06

set -euo pipefail

[[ -n "${SKIP_BUMP:-}" ]] && exit 0

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
[[ "$branch" != "main" ]] && exit 0

# Manual bump (e.g. major roll mid-month) — user staged VERSION themselves
if git diff --cached --name-only | grep -qx 'VERSION'; then
    exit 0
fi

staged=$(git diff --cached --name-only)
[[ -z "$staged" ]] && exit 0

# Docs-only commits don't bump — users won't see a phantom update banner
triggers_bump=false
while IFS= read -r f; do
    case "$f" in
        *.md|.claude/*|.githooks/*|LICENSE|.gitignore|.gitattributes)
            ;;
        *)
            triggers_bump=true
            break
            ;;
    esac
done <<< "$staged"

$triggers_bump || exit 0

current=$(cat VERSION 2>/dev/null || echo "")
today_major=$(date +%y.%m)

if [[ "$current" =~ ^([0-9]+\.[0-9]+)(\.([0-9]+))?$ ]]; then
    cur_major="${BASH_REMATCH[1]}"
    cur_patch="${BASH_REMATCH[3]:-0}"
else
    cur_major=""
    cur_patch=0
fi

# Compare YYMM integers so we never downgrade if VERSION is future-dated
cur_int="${cur_major//./}"
today_int="${today_major//./}"
: "${cur_int:=0}"

if [[ "$today_int" -gt "$cur_int" ]]; then
    new_version="$today_major"
else
    new_version="${cur_major:-$today_major}.$((cur_patch + 1))"
fi

printf '%s\n' "$new_version" > VERSION
git add VERSION
printf '[pre-commit] bumped %s → %s\n' "${current:-<empty>}" "$new_version" >&2
