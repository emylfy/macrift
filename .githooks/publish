#!/usr/bin/env bash
# Cut a release: bump VERSION right before pushing, commit it, push main.
# Run this INSTEAD of `git push` when you want to publish — the VERSION bump is
# what users see as "update available" (they get the file via the release
# tarball). The pre-push hook then tags v<VERSION>.
#
# Plain `git push` ships code WITHOUT a release (no bump, no new tag) — use it
# for WIP. Version is bumped only here, never per-commit, so day-to-day history
# stays free of version churn.

set -euo pipefail

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [[ "$branch" != "main" ]]; then
    printf 'publish: not on main (on %s) — aborting\n' "${branch:-detached HEAD}" >&2
    exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
    printf 'publish: working tree not clean — commit your work first\n' >&2
    exit 1
fi

# Calver bump: YY.MM → YY.MM.1 → YY.MM.2 … ; a new month resets (26.05.7 → 26.06).
current=$(cat VERSION 2>/dev/null || echo "")

# A prepared-but-unreleased VERSION (bumped by hand, no tag yet) must not be
# bumped again — push it as-is; the pre-push hook tags and releases it.
if [[ -n "$current" ]] && ! git rev-parse -q --verify "refs/tags/v$current" >/dev/null; then
    printf 'publish: v%s not yet released — pushing without a new bump\n' "$current"
    git push origin main
    printf 'publish: released v%s\n' "$current"
    exit 0
fi

today_major=$(date +%y.%m)
if [[ "$current" =~ ^([0-9]+\.[0-9]+)(\.([0-9]+))?$ ]]; then
    cur_major="${BASH_REMATCH[1]}"
    cur_patch="${BASH_REMATCH[3]:-0}"
else
    cur_major=""
    cur_patch=0
fi
# Compare YYMM integers so a future-dated VERSION never downgrades.
cur_int="${cur_major//./}"
today_int="${today_major//./}"
: "${cur_int:=0}"
if [[ "$today_int" -gt "$cur_int" ]]; then
    new_version="$today_major"
else
    new_version="${cur_major:-$today_major}.$((cur_patch + 1))"
fi

printf '%s\n' "$new_version" >VERSION
git add VERSION

# Optional: regenerate CHANGELOG.md from conventional commits via git-cliff so
# every release ships a human-readable history. Skip silently if the tool
# isn't installed (publish stays usable on stock systems).
if command -v git-cliff >/dev/null 2>&1; then
    if git-cliff --tag "v$new_version" -o CHANGELOG.md 2>/dev/null; then
        git add CHANGELOG.md
        printf 'publish: regenerated CHANGELOG.md (via git-cliff)\n'
    else
        printf 'publish: git-cliff failed — CHANGELOG.md not updated\n' >&2
    fi
fi

git commit -q -m "chore(release): v$new_version"
printf 'publish: %s → %s\n' "${current:-<empty>}" "$new_version"

# pre-push tags v<new_version> and carries it with the push.
git push origin main
printf 'publish: released v%s\n' "$new_version"
