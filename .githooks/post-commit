#!/usr/bin/env bash
# Auto-tag the commit when VERSION changes. Idempotent.

set -euo pipefail

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
[[ "$branch" != "main" ]] && exit 0

# Did HEAD touch VERSION?
git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | grep -qx 'VERSION' || exit 0

v=$(cat VERSION 2>/dev/null || true)
[[ -z "$v" ]] && exit 0

if git rev-parse --verify "v$v" >/dev/null 2>&1; then
    exit 0
fi

git tag "v$v" HEAD
printf '[post-commit] tagged v%s\n' "$v" >&2
